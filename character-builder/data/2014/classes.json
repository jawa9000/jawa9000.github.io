{
  "_note": "2014 Fighter through level 5. Differences from the 2024 Fighter: no Weapon Mastery at 1, no Tactical Mind at 2, no Tactical Shift at 5, and a different Fighting Style list. Wizard and Cleric mirror their 2024 entries for multiclass spell-slot math.",

  "fighter": {
    "id": "fighter",
    "name": "Fighter",
    "source": "PHB",
    "edition": "2014",
    "hitDie": 10,
    "primaryAbility": ["str", "dex"],
    "casterProgression": "none",
    "grants": [
      { "type": "saveProficiency", "ability": "str" },
      { "type": "saveProficiency", "ability": "con" },
      { "type": "armorProficiency", "value": "light" },
      { "type": "armorProficiency", "value": "medium" },
      { "type": "armorProficiency", "value": "heavy" },
      { "type": "armorProficiency", "value": "shields" },
      { "type": "weaponProficiency", "value": "simple" },
      { "type": "weaponProficiency", "value": "martial" },
      {
        "type": "choice",
        "id": "fighter:skills",
        "label": "Fighter — choose 2 skills",
        "count": 2,
        "from": [
          { "id": "acrobatics", "name": "Acrobatics", "grants": [{ "type": "skillProficiency", "skill": "acrobatics" }] },
          { "id": "animal-handling", "name": "Animal Handling", "grants": [{ "type": "skillProficiency", "skill": "animal-handling" }] },
          { "id": "athletics", "name": "Athletics", "grants": [{ "type": "skillProficiency", "skill": "athletics" }] },
          { "id": "history", "name": "History", "grants": [{ "type": "skillProficiency", "skill": "history" }] },
          { "id": "insight", "name": "Insight", "grants": [{ "type": "skillProficiency", "skill": "insight" }] },
          { "id": "intimidation", "name": "Intimidation", "grants": [{ "type": "skillProficiency", "skill": "intimidation" }] },
          { "id": "perception", "name": "Perception", "grants": [{ "type": "skillProficiency", "skill": "perception" }] },
          { "id": "survival", "name": "Survival", "grants": [{ "type": "skillProficiency", "skill": "survival" }] }
        ]
      }
    ],
    "multiclassGrants": [
      { "type": "armorProficiency", "value": "light" },
      { "type": "armorProficiency", "value": "medium" },
      { "type": "armorProficiency", "value": "shields" },
      { "type": "weaponProficiency", "value": "simple" },
      { "type": "weaponProficiency", "value": "martial" }
    ],
    "features": [
      {
        "level": 1,
        "name": "Fighting Style",
        "text": "You adopt a particular style of fighting as your specialty.",
        "grants": [
          {
            "type": "choice",
            "id": "fighter:fighting-style",
            "label": "Fighting Style",
            "count": 1,
            "from": [
              { "id": "archery", "name": "Archery", "text": "You gain a +2 bonus to attack rolls you make with ranged weapons.", "grants": [] },
              { "id": "defense", "name": "Defense", "text": "While you are wearing armor, you gain a +1 bonus to AC.", "grants": [{ "type": "acBonus", "value": 1, "requiresArmor": true }] },
              { "id": "dueling", "name": "Dueling", "text": "When you are wielding a melee weapon in one hand and no other weapons, you gain a +2 bonus to damage rolls with that weapon.", "grants": [] },
              { "id": "great-weapon-fighting", "name": "Great Weapon Fighting", "text": "When you roll a 1 or 2 on a damage die for an attack you make with a melee weapon that you are wielding with two hands, you can reroll the die.", "grants": [] },
              { "id": "protection", "name": "Protection", "text": "When a creature you can see attacks a target other than you that is within 5 feet of you, you can use your reaction to impose disadvantage on the attack roll. You must be wielding a shield.", "grants": [] },
              { "id": "two-weapon-fighting", "name": "Two-Weapon Fighting", "text": "When you engage in two-weapon fighting, you can add your ability modifier to the damage of the second attack.", "grants": [] }
            ]
          }
        ]
      },
      {
        "level": 1,
        "name": "Second Wind",
        "text": "You have a limited well of stamina that you can draw on to protect yourself from harm. On your turn, you can use a bonus action to regain hit points equal to 1d10 + your fighter level.",
        "grants": []
      },
      {
        "level": 2,
        "name": "Action Surge",
        "text": "You can push yourself beyond your normal limits for a moment. On your turn, you can take one additional action on top of your regular action and a possible bonus action.",
        "grants": []
      },
      {
        "level": 3,
        "name": "Martial Archetype",
        "text": "You choose an archetype that you strive to emulate in your combat styles and techniques.",
        "grants": []
      },
      {
        "level": 4,
        "name": "Ability Score Improvement",
        "text": "You can increase one ability score by 2, or two ability scores by 1 each. You can't increase an ability score above 20 using this feature.",
        "grants": [
          {
            "type": "choice",
            "id": "fighter:asi-4",
            "label": "Level 4 — Ability Score Improvement",
            "count": 1,
            "from": [
              { "id": "str2", "name": "+2 Strength", "grants": [{ "type": "ability", "ability": "str", "value": 2 }] },
              { "id": "dex2", "name": "+2 Dexterity", "grants": [{ "type": "ability", "ability": "dex", "value": 2 }] },
              { "id": "con2", "name": "+2 Constitution", "grants": [{ "type": "ability", "ability": "con", "value": 2 }] },
              { "id": "str1-con1", "name": "+1 Strength, +1 Constitution", "grants": [{ "type": "ability", "ability": "str", "value": 1 }, { "type": "ability", "ability": "con", "value": 1 }] },
              { "id": "dex1-con1", "name": "+1 Dexterity, +1 Constitution", "grants": [{ "type": "ability", "ability": "dex", "value": 1 }, { "type": "ability", "ability": "con", "value": 1 }] },
              { "id": "str1-dex1", "name": "+1 Strength, +1 Dexterity", "grants": [{ "type": "ability", "ability": "str", "value": 1 }, { "type": "ability", "ability": "dex", "value": 1 }] }
            ]
          }
        ]
      },
      {
        "level": 5,
        "name": "Extra Attack",
        "text": "You can attack twice, instead of once, whenever you take the Attack action on your turn.",
        "grants": []
      }
    ],
    "subclasses": {
      "champion": {
        "id": "champion",
        "name": "Champion",
        "source": "PHB",
        "features": [
          {
            "level": 3,
            "name": "Improved Critical",
            "text": "Your weapon attacks score a critical hit on a roll of 19 or 20.",
            "grants": []
          }
        ]
      }
    }
  },

